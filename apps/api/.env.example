# eLoop Diagnostics API - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Multimodal Vision API (OpenAI GPT-4o-mini or compatible)
# Get a free API key from https://platform.openai.com/api-keys
# Free tier: $5 credit on signup, then pay-as-you-go
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_API_KEY=your_openai_api_key_here
VISION_MODEL=gpt-4o-mini

# Alternative: Use a free/local vision model endpoint
# VISION_API_URL=http://localhost:11434/v1/chat/completions  # Ollama
# VISION_API_KEY=ollama  # Ollama doesn't need a real key
# VISION_MODEL=llava:latest